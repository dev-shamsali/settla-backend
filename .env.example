PORT=4000
NODE_ENV=development
# MongoDB Atlas or a local replica set
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Settla
MONGODB_DB=settla_dev
# Login attempts per minute per IP
AUTH_RATE_LIMIT=10
# Optional. Empty => in-process queue fallback (dev/test only)
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-min-32-chars-long-xxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-long-yyyyyyyy
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# 64 hex chars (32 bytes) for AES-256-GCM credential encryption
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
# mock | live
INTEGRATION_MODE=mock
# mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
SMTP_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- n8n integration (backend-gated; n8n never decides policy) ---
# mock = in-process contract simulator (default). live = signed HTTPS call to N8N_WEBHOOK_URL
N8N_MODE=mock
N8N_WEBHOOK_URL=
# >=32 chars; shared with n8n for HMAC request signing (never commit)
N8N_SIGNING_SECRET=
# value for the n8n Webhook Header Auth credential (never commit)
N8N_WEBHOOK_AUTH_TOKEN=
N8N_ALLOWED_HOSTS=n8n.cloud
# development-only WhatsApp recipient, resolved inside n8n; never sent in payloads or logs
SETTLA_TEST_WHATSAPP_NUMBER=
