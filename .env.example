PORT=4000
NODE_ENV=development
# MongoDB Atlas or a local replica set
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Settla
MONGODB_DB=settla_dev
# Optional. Empty => in-process queue fallback (dev/test only)
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-min-32-chars-long-xxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-long-yyyyyyyy
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# 64 hex chars (32 bytes) for AES-256-GCM credential encryption
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
# mock | live
INTEGRATION_MODE=mock
# mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
SMTP_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
